# Всё лишнее не отправляется на демон-сервер Docker.
# Шаблоны без «**/» действуют только от корня контекста, поэтому
# вложенные каталоги перечислены отдельно.

# система контроля версий и служебные каталоги разработки
.git
.github
.gitignore
.scratch
.vscode
**/.vscode
.idea
**/.idea
Thumbs.db
Desktop.ini
.DS_Store

# зависимости и виртуальные окружения
node_modules
frontend/node_modules
**/node_modules
.venv
backend/.venv
**/.venv
venv
**/venv
env
**/env

# результаты сборки
dist
frontend/dist
**/dist
.vite
**/.vite

# байт-код Python
__pycache__
**/__pycache__
*.pyc
**/*.pyc
*.pyo
**/*.pyo

# переменные окружения и секреты
.env
**/.env
.env.*
!backend/.env.example

# материалы, не участвующие в сборке образа
docs
screens_from_figma
images_from_figma
*.docx
**/*.docx
*.pdf
**/*.pdf
*.md
**/*.md
