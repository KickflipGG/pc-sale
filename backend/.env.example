# =============================================================================
#  PC Sale — пример файла переменных окружения
#  Скопируйте в .env и укажите свои значения. Файл .env в git не попадает.
# =============================================================================

# Строка подключения к PostgreSQL (драйвер psycopg 3).
# Подставьте имя пользователя и пароль своей локальной СУБД.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/pc_sale

# Секретный ключ подписи JWT. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Время жизни токена доступа в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Список источников, которым разрешены запросы к API (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
